{
  "name": "roomrelay",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@10.34.6",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "dev": "pnpm --filter @roomrelay/web dev",
    "build": "pnpm -r build",
    "test": "pnpm -r test",
    "test:e2e": "pnpm --filter @roomrelay/web test:e2e",
    "typecheck": "pnpm -r typecheck",
    "lint": "node scripts/lint.mjs",
    "db:migrate": "pnpm --filter @roomrelay/web exec prisma migrate deploy && pnpm --filter @roomrelay/web exec prisma generate",
    "fixtures:fetch": "node scripts/fetch-fixtures.mjs",
    "paypal:sandbox-smoke": "pnpm --filter @roomrelay/web paypal:sandbox-smoke"
  },
  "devDependencies": {}
}
