# RoomRelay configuration template — placeholders only, never real values.
# Capability groups are declared in ARCHITECTURE.md A-07. A capability is
# `available` only when every variable in its group is set.

# --- Database / API ---
DATABASE_URL="postgresql://roomrelay:roomrelay-dev@localhost:5432/roomrelay"
ROOMRELAY_WEB_BASE_URL="http://localhost:3000"
ROOMRELAY_API_BASE_URL="http://localhost:3000"

# --- Identity (Clerk) ---
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=""
CLERK_SECRET_KEY=""
CLERK_JWT_KEY=""
# For a local temporary development instance, run `npx clerk@latest init` in apps/web.
# Disable keyless development mode with a truthy value when needed.
NEXT_PUBLIC_CLERK_KEYLESS_DISABLED=""
# Android-side key (not used by the web server):
CLERK_PUBLISHABLE_KEY=""

# --- Object store (private S3-compatible) ---
OBJECT_STORE_LOCAL_DIR=""
OBJECT_STORE_ENDPOINT=""
OBJECT_STORE_REGION=""
OBJECT_STORE_BUCKET=""
OBJECT_STORE_ACCESS_KEY_ID=""
OBJECT_STORE_SECRET_ACCESS_KEY=""

# --- PayPal (sandbox default) ---
PAYPAL_ENVIRONMENT="sandbox"
NEXT_PUBLIC_PAYPAL_CLIENT_ID=""
PAYPAL_CLIENT_SECRET=""
PAYPAL_WEBHOOK_ID=""
PAYPAL_MERCHANT_ID=""
# Must remain false unless production onboarding is explicitly authorized.
ALLOW_LIVE_PAYMENTS="false"
ROOMRELAY_OPERATOR_IDS=""
PAYPAL_SMOKE_APPROVAL_TIMEOUT_SECONDS="600"

# --- Text model (server-side structured output) ---
AI_PROVIDER=""
AI_API_KEY=""
AI_TEXT_MODEL=""

# --- Workers ---
WORKER_CONCURRENCY="1"

# Development/E2E test identity only; refused in production.
ROOMRELAY_TEST_IDENTITY=""
TEST_DATABASE_URL="postgresql://roomrelay:roomrelay-dev@localhost:5432/roomrelay_test"
